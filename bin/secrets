#!/usr/bin/env bash
set -euo pipefail

SOPS_FILE="$HOME/dotfiles/secrets.yaml"

usage() {
  cat <<EOF
Usage: passwd [command]

Commands:
  edit       Open and edit secrets with sops (default)
  show       Print decrypted secrets
EOF
  exit 1
}

cmd="${1:-edit}"

case "$cmd" in
  edit)
    sops "$SOPS_FILE"
    ;;
  show)
    sops --decrypt "$SOPS_FILE"
    ;;
  *)
    usage
    ;;
esac
