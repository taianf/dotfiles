#!/usr/bin/env bash
set -euo pipefail

STATE="/data/.state"
SOPS_FILE="$HOME/dotfiles/secrets.yaml"

setup_dirs() {
  echo "Creating jellyfin directories..."
  sudo mkdir -p "$STATE/jellyfin/config" "$STATE/jellyfin/cache" "$STATE/jellyfin/log" "$STATE/jellyfin/data"
  sudo chown -R jellyfin:media "$STATE/jellyfin"
  echo "Done."
}

cmd="${1:-help}"

case "$cmd" in
  restart)
    for svc in postgresql nginx sonarr radarr lidarr prowlarr sabnzbd jellyfin seerr; do
      echo "Restarting $svc..."
      sudo systemctl restart "$svc.service" 2>/dev/null || echo "  → skipped"
    done
    echo "Done."
    ;;
  clean)
    echo "Stopping all services..."
    for svc in jellyfin sonarr radarr lidarr prowlarr sabnzbd seerr nginx postgresql; do
      sudo systemctl stop "$svc.service" 2>/dev/null || true
    done
    echo "Removing all state data..."
    sudo rm -rf "$STATE"/{jellyfin,sonarr,radarr,lidarr,prowlarr,seerr}
    setup_dirs
    echo "Done. Run: nixup"
    ;;
  setup)
    setup_dirs
    echo "Done. Run: nixup"
    ;;
  secrets)
    sub="${2:-edit}"
    case "$sub" in
      edit)  sops "$SOPS_FILE" ;;
      show)  sops --decrypt "$SOPS_FILE" ;;
      *)     echo "Usage: nixflix secrets {edit|show}" ;;
    esac
    ;;
  *)
    echo "Usage: nixflix {restart|clean|setup|secrets}"
    ;;
esac
