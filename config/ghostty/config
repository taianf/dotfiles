# Ghostty terminal configuration.
#
# Source of truth for ~taian's dotfiles: this file is auto-synced from
# ~/.config/ghostty/config by bin/sync-dotfiles (systemd path unit). Edit
# either side; live wins.
#
# See SYNC.md for the full sync workflow.

# Match Zed's default theme follow behavior.
theme = auto

# Slightly larger than Zed (16) so terminal text doesn't feel cramped.
font-size = 14

# Reasonable padding for a tiling-style window.
window-padding-x = 8
window-padding-y = 4

# Confirm quitting — Cmd+Q on macOS, Ctrl+Q on Linux.
confirm-close = true
