# rsync --exclude patterns for bin/sync-dotfiles.
# Lines starting with '#' and blank lines are ignored.
# Pattern syntax matches rsync's --exclude (glob-style, not full gitignore).

# Editor / OS metadata
*.swp
*.swo
*.bak
*~
.DS_Store

# Locks / IPC (created by Chrome, Firefox, Electron apps, etc.)
*.lock
LOCK
LOCKFILE
SingletonLock
.parentlock
Socket
.sock

# Caches (regenerated by programs on demand)
Cache
cache
Code Cache
GPUCache
CachedData
CachedExtensions

# Per-machine overrides
*.local
