# === Top-level app directories that are pure runtime state ===
# These apps store all of their state in ~/.config/<app>/ and there's
# nothing in there worth tracking for a dotfiles repo.
# Uncomment to silence, or remove to track a specific app's config.
# ~/.config/epiphany/
# ~/.config/evolution/
# ~/.config/gnome-initial-setup-done
# ~/.config/gtk-3.0/
# ~/.config/ibus/
# ~/.config/kilo/
# ~/.config/mimeapps.list
# ~/.config/monitors.xml
# ~/.config/nautilus/
# ~/.config/pulse/
# ~/.config/qt5ct/
# ~/.config/qt6ct/
# ~/.config/systemd/
# ~/.config/user-dirs.dirs
# ~/.config/user-dirs.locale

