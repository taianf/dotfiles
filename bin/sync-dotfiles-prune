#!/usr/bin/env bash
# bin/sync-dotfiles-prune: one-time cleanup of cache files in
# ~/dotfiles/config/ that shouldn't have been mirrored.
#
# Reads .sync-ignore and removes any files in config/ that match the
# exclude patterns. Use after expanding .sync-ignore to clean up a
# pre-existing backlog (e.g., a 4.9 GB google-chrome cache that
# slipped through before the patterns were tight).
#
# Usage:
#   bin/sync-dotfiles-prune           # delete matching files
#   bin/sync-dotfiles-prune --dry-run # show what would be deleted
#
# SAFE: only touches files in ~/dotfiles/config/ that match an exclude
# pattern. Live ~/.config/ is NEVER modified. Tracked files in git are
# removed from the working tree AND `git rm`-ed; untracked files are
# just `rm`-ed.

set -euo pipefail

DOTFILES="${HOME}/dotfiles"
CONFIG="${DOTFILES}/config"
SYNC_IGNORE="${DOTFILES}/.sync-ignore"

if [ ! -d "${CONFIG}" ]; then
  echo "No config/ at ${CONFIG}" >&2
  exit 1
fi
if [ ! -f "${SYNC_IGNORE}" ]; then
  echo "No .sync-ignore at ${SYNC_IGNORE}" >&2
  exit 1
fi

DRY_RUN=0
if [ "${1:-}" = "--dry-run" ]; then
  DRY_RUN=1
fi

# Load exclude patterns.
EXCLUDES=()
while IFS= read -r line; do
  case "${line}" in
    ''|'#'*) continue ;;
  esac
  line="${line%/}"
  EXCLUDES+=(--exclude="${line}")
done < "${SYNC_IGNORE}"

# Find files in CONFIG/ that match the exclude patterns.
# Trick: rsync the config dir to /dev/null with the excludes, in dry-run
# mode. rsync will list files that WOULD be excluded, prefixed with
# "skipping non-regular file" or "deleting" depending on the type.
# Simpler: use rsync --list-only to enumerate SRC contents that survive
# the excludes, then diff against the actual config/ tree to find
# what's excluded.

mapfile -t SURVIVORS < <(rsync -a --list-only "${EXCLUDES[@]}" "${CONFIG}/" /tmp/ 2>/dev/null \
  | awk '{ for (i=5; i<=NF; i++) printf "%s%s", $i, (i<NF?" ":"\n") }' \
  | sed 's|^\./||' \
  | sort -u)

# Anything in config/ that isn't a survivor should be deleted.
mapfile -t TO_DELETE < <(cd "${CONFIG}" && find . -mindepth 1 \
  | while read -r p; do
      rel="${p#./}"
      if ! printf '%s\n' "${SURVIVORS[@]}" | grep -qxF "${rel}"; then
        printf '%s\n' "${p}"
      fi
    done)

if [ ${#TO_DELETE[@]} -eq 0 ]; then
  echo "sync-dotfiles-prune: no files to delete"
  exit 0
fi

echo "Found ${#TO_DELETE[@]} files/dirs to delete:"
printf '  %s\n' "${TO_DELETE[@]}"
echo

if [ "${DRY_RUN}" -eq 1 ]; then
  echo "DRY RUN — nothing was deleted. Re-run without --dry-run to apply."
  exit 0
fi

# Apply. Use `git rm` for tracked files, `rm -rf` for untracked.
# Empty the array on the fly to keep memory low on large backlogs.
total=${#TO_DELETE[@]}
i=0
for rel in "${TO_DELETE[@]}"; do
  i=$((i + 1))
  full="${CONFIG}/${rel#./}"
  if git -C "${DOTFILES}" ls-files --error-unmatch "${rel}" >/dev/null 2>&1; then
    git -C "${DOTFILES}" rm -rf --quiet "${rel}" 2>/dev/null || true
  else
    rm -rf -- "${full}"
  fi
  # progress every 100
  if [ $((i % 100)) -eq 0 ]; then
    echo "  ... $i/$total"
  fi
done

echo "Deleted $i files/dirs from ${CONFIG}"

# Commit the prune if there are any staged removals.
cd "${DOTFILES}"
if ! git diff --cached --quiet; then
  git commit -m "chore: prune cache files from config/ per .sync-ignore

Auto-generated by bin/sync-dotfiles-prune after expanding
.sync-ignore to catch the pre-existing backlog (4.9 GB of
google-chrome, 218 MB of Ferdium, 48 MB of mozilla, etc.)."
  echo "Committed prune."
else
  echo "Nothing left to commit."
fi
