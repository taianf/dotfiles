{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "lsp": "allow"
  },
  "plugin": [
    "@dietrichgeber/ponytail",
    "oh-my-opencode",
    "opencode-goal-plugin",
    "opencode-pty",
    "opencode-supermemory"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  }
}
