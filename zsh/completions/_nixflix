#compdef nixflix

_nixflix() {
  local -a subcmds
  subcmds=(
    'restart:Restart all nixflix services'
    'refresh:Re-run config oneshot services'
    'clean:Wipe all state data and recreate dirs'
    'full-refresh:Clean state, rebuild system, re-apply config'
    'setup:Recreate jellyfin directories'
    'secrets:Manage encrypted secrets'
  )
  _describe 'nixflix' subcmds
}

compdef _nixflix nixflix
