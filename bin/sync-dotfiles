#!/usr/bin/env bash
# bin/sync-dotfiles: mirror user-editable live dotfiles to the repo,
# then commit + push. Triggered by the systemd `dotfiles-sync.path`
# unit (see home/services.nix) when any file under ~/.config/ changes.
# Manual invocation is also fine: `bin/sync-dotfiles`.
#
# Sync direction: live -> repo. Live is canonical. Anything in the repo
# that's no longer in live (e.g. a config the user uninstalled) is
# removed with `git rm`. Anything new in live is `git add`'d. This is
# the "live wins, repo mirrors" half of the model. The boot-time
# `dotfiles-sync-on-boot.service` does the *other* half: pull main and
# copy any new files into live (additive only, never overwrites).
#
# See SYNC.md for the full workflow.

set -euo pipefail

DOTFILES="${HOME}/dotfiles"
CONFIG="${DOTFILES}/config"
SYNC_IGNORE="${DOTFILES}/.sync-ignore"

# rsync excludes, derived from .sync-ignore if present, else defaults.
if [ -f "${SYNC_IGNORE}" ]; then
  # Convert gitignore-style patterns to rsync --exclude args.
  # Supports globs and directory names; ignores comments and blank lines.
  EXCLUDES=()
  while IFS= read -r line; do
    # strip comments and blanks
    case "${line}" in
      ''|'#'*) continue ;;
    esac
    # strip trailing slash (rsync wants bare name for dirs)
    line="${line%/}"
    EXCLUDES+=(--exclude="${line}")
  done < "${SYNC_IGNORE}"
else
  EXCLUDES=(
    --exclude='node_modules'
    --exclude='*.lock'
    --exclude='*.swp'
    --exclude='*.swo'
    --exclude='*.bak'
    --exclude='*~'
    --exclude='Cache'
    --exclude='cache'
    --exclude='GPUCache'
    --exclude='Code Cache'
    --exclude='*.local'
    --exclude='Socket'
    --exclude='.DS_Store'
    --exclude='LOCK'
    --exclude='LOCKFILE'
    --exclude='SingletonLock'
    --exclude='.parentlock'
  )
fi

mkdir -p "${CONFIG}"

# Mirror ~/.config/* -> ~/dotfiles/config/*.
# --update: don't overwrite a newer file in the destination (defense in
# depth; live is supposed to be newer or equal, but be safe).
# --delete: remove files from the destination that are no longer in
# the source (after the excludes). This keeps the repo in sync if a
# user-edited file is removed from live — without --delete, stale
# copies accumulate forever.
rsync -a --update --delete "${EXCLUDES[@]}" "${HOME}/.config/" "${CONFIG}/"

# Special-case files that don't live in ~/.config/ but are still
# user-editable dotfiles.
mkdir -p "${CONFIG}/zsh"
rsync -a --update "${HOME}/.zshrc" "${CONFIG}/zsh/.zshrc"

# Stage everything that changed (or was deleted) in this mirror.
cd "${DOTFILES}"
git add -A

# Bail if nothing changed (no commit spam).
if git diff --cached --quiet; then
  echo "sync-dotfiles: no changes"
  exit 0
fi

# Commit. Author/committer come from the user's git config (see
# programs.git in home/programs.nix).
git commit -m "auto-sync: $(date -Iseconds)"

# Best-effort push. If the network is down or main is ahead, don't
# fail the sync — the next boot pull (or next sync) will reconcile.
if ! git push origin main 2>/dev/null; then
  echo "sync-dotfiles: push failed (will retry on next sync or boot pull)"
fi
