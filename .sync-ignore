# === PulseAudio / Qt / GTK runtime config ===
pulse
qt5ct
qt6ct
gtk-3.0

# === nix / sops runtime caches ===
# config/nix/ holds nix metadata; config/sops/ holds sops age keys
nix
sops
age

# === opencode auto-installed runtime ===
# - skills/ is populated by `bun add` of oh-my-opencode-slim plugins
# - .oh-my-opencode-slim/ is a cache
# - *.backup is topgrade-style "save before edit" leftovers
# - test-via-write is a tmp file dropped by some test harness
# - AGENTS.md is ignored per user decision (can be re-added via
#   seed-dotfiles if it becomes important)
opencode/skills
opencode/.oh-my-opencode-slim
opencode/AGENTS.md
opencode/test-via-write
opencode/.gitignore.backup
*.backup

# === topgrade's symlink-resolution leftovers ===
# topgrade rewrites topgrade.toml as a symlink to topgrade.toml.real,
# saving the previous version as topgrade.toml.backup. Both are noise.
topgrade.toml.backup
topgrade.toml.real

# === herdr runtime (config.toml is small user config; we keep
# the directory, but the session file is pure runtime) ===
herdr/session.json

# === kilo (opencode agent) ===
# Default config is essentially empty; if you start customizing,
# remove this ignore and seed it via seed-dotfiles.
kilo/kilo.jsonc

# === Legacy home-manager config dropped here by an old
# `nix run home-manager init`. The real home.nix is at the repo
# root; this directory is just a bootstrap artifact. ===
home-manager

# === ibus: also kill the whole config (pure runtime) ===
# (Uncomment if you want a hard kill; comment to inspect what's there.)
# ibus
