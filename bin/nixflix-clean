#!/usr/bin/env bash
set -euo pipefail

echo "Stopping all nixflix services..."
for svc in jellyfin sonarr radarr lidarr prowlarr sabnzbd seerr nginx postgresql; do
  sudo systemctl stop "$svc.service" 2>/dev/null || true
done

echo "Removing all nixflix state data..."
sudo rm -rf /data/.state/jellyfin
sudo rm -rf /data/.state/sonarr
sudo rm -rf /data/.state/radarr
sudo rm -rf /data/.state/lidarr
sudo rm -rf /data/.state/prowlarr
sudo rm -rf /data/.state/seerr

echo "Recreating directories..."
sudo mkdir -p /data/.state
sudo mkdir -p /data/.state/jellyfin/config /data/.state/jellyfin/cache /data/.state/jellyfin/log /data/.state/jellyfin/data
sudo chown -R jellyfin:media /data/.state/jellyfin

echo "Done. Run nixup to recreate everything fresh."
