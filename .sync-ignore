"Reporting and NEL*"
SmartScreen*
"Safe Browsing"
"Trust Token Safe Browsing"
crowd_deny
certificate_provider
component_cached_*
extensions_settings
external_extensions
extension_crx_cache
"GCM Store"
"GraphiteDawnCache"
HeavyAdSitesEngagement
ledger.bin*
MEIPreload
